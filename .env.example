# Server
PORT=4000
JWT_SECRET=change-me
JWT_TTL=12h
ADMIN_PASSWORD=admin123
DISPATCHER_PASSWORD=dispatcher123
CORS_ORIGINS=http://localhost:5173
# Routing chain (priority order): osrm = external OSRM API, simulated = internal road graph
ROUTING_PROVIDERS=osrm,simulated
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=2500
# Persistence (SQLite file, or "off" for pure in-memory)
DB_FILE=panigo-events.db
# Dataset: real OSM/Wikidata (default) or "curated" fallback
# DATASET=curated
# Protection
RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT_PER_MIN=20
SOS_PER_CITIZEN_PER_MIN=6
# Challenge Drop 3 — SOS flood protection
GUEST_PER_IP_PER_MIN=20
SOS_PER_IP_PER_MIN=30
OPS_PER_OPERATOR_PER_MIN=60
# which proxy hops may set X-Forwarded-For (loopback = Vite dev proxy / local tunnel; number = hop count)
TRUST_PROXY=loopback
# Realtime batching window (ms) and simulation speed
BROADCAST_INTERVAL_MS=250
SIMULATION=on
TIME_SCALE=4
# Client (Vite): self-hosted tile server for offline/outage mode
# VITE_TILE_URL=http://localhost:8080/{z}/{x}/{y}.png
